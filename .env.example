# Which of these are secret, and which only look it
#
# Anything named NEXT_PUBLIC_* is compiled into the JavaScript every
# visitor downloads. It is public by definition, so marking one of them
# "sensitive" in Vercel buys no security and can stop the value reaching
# the build - which is how a QR code ends up pointing at an address that
# doesn't exist while everything else looks healthy.
#
# The two below with no NEXT_PUBLIC_ prefix are the genuinely secret ones
# and should be restricted: the service role key bypasses every row
# security rule in the database, and the cron secret is what stops anyone
# triggering the scheduled job.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key, server-only. Needed to read graph_node_id/private fields
# that are not exposed through the public_* views. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL used when encoding QR codes (no trailing slash).
#
# Leave this unset in production. The live site serves
# directions.providencelifestyle.com.au, and with no value here the app
# reads Vercel's production domain at runtime instead - which is right by
# definition and can't go stale the way a copy of it can. Set it locally
# only to aim a code somewhere other than localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Set this in Vercel to lock down the daily keep-alive cron
# (/api/cron/keepalive) that stops the free-tier Supabase project pausing
# through inactivity. Vercel sends it automatically as a Bearer token.
CRON_SECRET=any-long-random-string

# Optional, and for testing only. Set to 1 to add a "Simulated position"
# panel to the visitor page, which walks a pretend visitor along the
# route so live directions can be exercised without standing at a
# resort. Set it on Vercel's Preview environment only - a build carrying
# it shows the panel to anyone who opens that deployment.
NEXT_PUBLIC_POSITION_SIM=
